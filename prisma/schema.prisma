generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id                     String   @id @default(cuid())
  siteName               String   @default("LUDO Sports Kitchen & Coffee")
  siteTagline            String   @default("EAT · WATCH · CONNECT")
  whatsappNumber         String   @default("6282318560003")
  defaultWhatsappMessage String   @default("Halo LUDO, saya ingin reservasi meja.")
  matchSectionTitle      String   @default("THIS WEEK MATCH")
  headerBookingLabel     String   @default("WhatsApp")
  headerBookingUrl       String?
  headerBookingVisible   Boolean  @default(true)
  eventMiceLabel         String   @default("Event / MICE")
  eventMiceUrl           String   @default("/event-mice")
  eventMiceVisible       Boolean  @default(true)
  instagramHandle        String   @default("@ludosportskitchen")
  instagramUrl           String   @default("https://www.instagram.com/ludosportskitchen/")
  tiktokHandle           String   @default("@ludosportskitchen")
  tiktokUrl              String   @default("https://www.tiktok.com/@ludosportskitchen")
  menuUrl                String   @default("https://drive.google.com/drive/folders/1qvRivb-6awFzYvzaCEP9H0NbM3EIcU9r")
  footerCopyright        String   @default("© 2026 LUDO SPORTS KITCHEN & COFFEE. ALL RIGHTS RESERVED.")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model MatchCard {
  id               String           @id @default(cuid())
  displayMode      MatchDisplayMode @default(TEAM_MATCH)
  // Mirrors BookingEvent.eventType (same EventTemplate enum, reused on purpose):
  // REGULER_MATCH = WhatsApp CTA only (no BookingEvent provisioned).
  // BIG_MATCH / SUPER_BIG_MATCH / IFTAR_2027 = full table + package payment flow.
  // NOBAR_COMMUNITY = per-seat payment flow.
  matchCategory    EventTemplate    @default(BIG_MATCH)
  leagueName       String
  title            String?
  categoryLabel    String?
  description      String?          @db.Text
  eventImage       String?
  homeTeamName     String?
  awayTeamName     String?
  homeTeamLogo     String?
  awayTeamLogo     String?
  matchDateLabel   String
  matchTimeLabel   String
  venueLocation    String?
  scheduledAt      DateTime?
  status           MatchStatus
  buttonLabel      String
  whatsappMessage  String?
  showSoldOutStamp Boolean          @default(false)
  subTextTitle     String?
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bookingEventId   String?
  bookingEvent     BookingEvent?    @relation(fields: [bookingEventId], references: [id], onDelete: SetNull)

  @@index([bookingEventId])
}

enum MatchStatus {
  BOOK
  LIMITED
  FULL_BOOKED
  CURRENTLY_SHOWING
}

enum MatchDisplayMode {
  TEAM_MATCH
  GENERAL_EVENT
}

model HeroSection {
  id                 String   @id @default(cuid())
  headlineLine1      String   @default("BIG")
  headlineHighlight1 String   @default("MATCH,")
  headlineLine2      String   @default("BIG")
  headlineHighlight2 String   @default("FLAVOR.")
  subtitle           String   @default("Nonton seru, makan enak, suasana maksimal.")
  ctaLabel           String   @default("BOOK YOUR TABLE NOW")
  ctaWhatsappMessage String   @default("Halo LUDO, saya ingin reservasi meja.")
  backgroundImage    String?
  portraitImage      String?  @db.Text
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum EventCategory {
  LIVE_EVENT
  BOOKING_EVENT
}

model LocationSetting {
  id              String   @id @default(cuid())
  businessName    String   @default("LUDO Sports Kitchen & Coffee")
  address         String   @default("Jl. Kiara Artha No.C23 Blok F6B 4, Kec. Batununggal, Kota Bandung, Jawa Barat")
  mapImage        String?
  mapUrl          String   @default("https://www.google.com/maps/search/?api=1&query=LUDO%20Sports%20Kitchen%20%26%20Coffee%20Kiara%20Artha%20Bandung")
  instagramHandle String   @default("@ludosportskitchen")
  instagramUrl    String   @default("https://www.instagram.com/ludosportskitchen/")
  tiktokHandle    String   @default("@ludosportskitchen")
  tiktokUrl       String   @default("https://www.tiktok.com/@ludosportskitchen")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandSection {
  id                   String   @id @default(cuid())
  titleBeforeHighlight String   @default("TRUSTED BY")
  titleHighlight       String   @default("LEADING BRANDS")
  subtitle             String   @default("Official Brand Partner")
  brandName            String   @default("Coca-Cola")
  brandLogo            String?
  bottomText           String   @default("EXCLUSIVE COLLABORATION")
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  caption      String?  @db.Text
  videoUrl     String   @db.Text
  thumbnailUrl String?  @db.Text
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EventMiceSetting {
  id                  String   @id @default(cuid())
  heroHeadline        String
  heroDescription     String   @db.Text
  section2Headline    String
  section2Description String   @db.Text
  quoteText           String
  updatedAt           DateTime @updatedAt
}

// ==========================================
// UNIFIED EVENT & BOOKING SYSTEM
// ==========================================

model BookingEvent {
  id                 String           @id @default(cuid())
  category           EventCategory    @default(BOOKING_EVENT)
  title              String
  eventType          EventTemplate    @default(REGULER_MATCH)
  eventTypeLabel     String?
  artistName         String?
  talentLabel        String?
  eventDateLabel     String
  eventTimeLabel     String
  scheduledAt        DateTime?
  description        String?          @db.Text
  whatsappMessage    String?
  headlineLine1      String?
  headlineHighlight1 String?
  headlineLine2      String?
  headlineHighlight2 String?
  backgroundImage    String?
  posterImage        String?
  openGateInfo       String?          @default("Open Gate at 21:00 WIB")
  tableInfo          String?          @db.Text
  ctaLabel           String           @default("BOOK NOW")
  allowAlaCarte      Boolean          @default(false)
  isActive           Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  packages           EventPackage[]
  tables             EventTable[]
  reservations       Reservation[]
  matches            MatchCard[]
}

model EventPackage {
  id              String            @id @default(cuid())
  bookingEventId  String
  name            String
  description     String?           @db.Text
  price           Float             @default(0)
  posterImage     String?
  tableType       TableType
  category        DeliveryCategory?
  subCategory     String?
  isActive        Boolean           @default(true)
  isSoldOut       Boolean           @default(false)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookingEvent    BookingEvent      @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([bookingEventId])
}

model EventTable {
  id              String       @id @default(cuid())
  bookingEventId  String
  tableCode       String       // e.g. "T1", "T22-A", "Barstool-A"
  capacity        Int          @default(1)
  tableType       TableType
  status          TableStatus  @default(AVAILABLE)
  basePrice       Float        @default(0)
  bookedSeats     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bookingEvent    BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@unique([bookingEventId, tableCode])
  @@index([bookingEventId])
}

model Reservation {
  id                  String             @id @default(cuid())
  bookingEventId      String
  customerName        String
  customerPhone       String
  customerEmail       String
  customerRequest     String?            @db.Text
  status              ReservationStatus  @default(PENDING)
  totalPrice          Float              @default(0)
  tax                 Float              @default(0)
  taxServiceAmount    Float              @default(0)
  discountAmount      Float              @default(0)
  memberUsername      String?
  snapToken           String?
  transactionId       String?            @unique
  paymentMethod       String?
  fraudStatus         String?
  paymentCallbackData String?            @db.Text
  paidAt              DateTime?
  expiredAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  bookingEvent        BookingEvent       @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]

  @@index([bookingEventId])
}

model OrderItem {
  id              String        @id @default(cuid())
  reservationId   String
  eventPackageId  String?
  eventTableId    String?
  quantity        Int           @default(1)
  price           Float         @default(0)
  note            String?       @db.Text
  createdAt       DateTime      @default(now())

  reservation     Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventPackage    EventPackage? @relation(fields: [eventPackageId], references: [id], onDelete: SetNull)
  eventTable      EventTable?   @relation(fields: [eventTableId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([eventPackageId])
  @@index([eventTableId])
}

enum EventTemplate {
  REGULER_MATCH
  NOBAR_COMMUNITY
  BIG_MATCH
  SUPER_BIG_MATCH
  IFTAR_2027
  DELIVERY_ORDER
}

enum TableType {
  VVIP
  VIP
  REGULAR_INDOOR
  REGULAR_SEMI_OUTDOOR
  // Separate from REGULAR_SEMI_OUTDOOR (4 pax) so packages can be filtered
  // cleanly by table type without guessing off capacity. 2-pax outdoor tables
  // (32-35) use this value.
  REGULAR_SEMI_OUTDOOR_2P
  BARSTOOL
  DELIVERY
}

enum DeliveryCategory {
  BEVERAGES
  FOOD
}

model Member {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  category        String?
  discountPercent Float    @default(0)
  benefitNote     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum TableStatus {
  AVAILABLE
  SELECTED
  BOOKED
  PAID
  LOCKED
}

enum ReservationStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}
